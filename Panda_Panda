def fill_avo(row): #else and if
    if pd.notna(row['Improved Access to Digital Finance']):
        return row['Improved Access to Digital Finance']
    elif pd.notna(row['Improved Governance and Institutional Capacity']):
        return row['Improved Governance and Institutional Capacity']
    elif pd.notna(row['Improved Effectiveness and Efficiency']):
        return row['Improved Effectiveness and Efficiency']
    elif pd.notna(row['Productivity Increased']):
        return row['Productivity Increased']
    elif pd.notna(row['Business Growth']):
        return row['Business Growth']
    else:
        return 1

